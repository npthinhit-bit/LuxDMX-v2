I need to rewrite the `.clang-tidy` file. It was way too verbose with duplicate entries. Let me create a clean, proper configuration.</think>That `.clang-tidy` file got out of hand. Let me rewrite it properly.<tool_call>write<arg_key>content</arg_key><arg_value># .clang-tidy — Static analysis configuration for LuxDMX-v2 firmware
# Run in CI with: clang-tidy -p . --checks='-*' --list-checks
# Requires compile_commands.json from bear -- pio run -e esp32dev

---
Checks: >
  bugprone-*,
  cert-*,
  -cert-err34-c,
  -cert-int31-c,
  -cert-msc30-c,
  -cert-msc50-cpp,
  -cert-str30-c,
  -cert-str31-c,
  -cert-str32-c,
  -cert-str33-c,
  -cert-str34-c,
  -cert-err40-c,
  -cert-err58-cpp,
  -cert-err60-cpp,
  -cert-err61-cpp,
  -cert-dcl16-c,
  -cert-dcl18-c,
  -cert-env33-c,
  -cert-fio31-c,
  -cert-fio32-c,
  -cert-fio33-c,
  -cert-fio34-c,
  -cert-fio35-c,
  -cert-fio36-c,
  -cert-fio37-c,
  -cert-fio38-c,
  -cert-fio39-c,
  -cert-fio40-c,
  -cert-fio41-c,
  -cert-fio42-c,
  -cert-fio45-c,
  -cert-fio46-c,
  -cert-fio47-c,
  -cert-fio48-c,
  -cert-fio49-c,
  -cert-fio50-c,
  -cert-flp37-c,
  -cert-oob-translate,
  -cert-int11-c,
  -cert-int33-c,
  -cert-int34-c,
  -cert-int35-c,
  -cert-int36-c,
  -cert-msc24-c,
  -cert-msc31-c,
  google-runtime-int,
  google-runtime-references,
  google-runtime-magic-strings,
  google-build-padding,
  google-build-using-namespace,
  google-build-names,
  google-readability-namespace-comments,
  google-readability-braces-around-statements,
  google-readability-function-size,
  readability-*,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-else-after-return,
  -readability-suspicious-call-operator,
  -readability-non-const-parameter,
  -readability-isolate-declaration,
  -readability-non-describing-parameter-name,
  -readability-qualified-auto,
  performance-*,
  -performance-no-automatic-move,
  -performance-no-accumulate,
  -performance-fallthrough,
  -performance-implicit-cast-copy,
  -performance-move-const-arg,
  -performance-move-declaration-unless,
  -performance-no-int-to-ptr,
  -performance-no-iterator,
  -performance-type-padded,
  -performance-unnecessary-value-param,
  clang-analyzer-*,
  -clang-analyzer-cplusplus.NewDelete,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  -clang-analyzer-core.VLASize,
  -clang-analyzer-core.CallAndMessage,
  -clang-analyzer-core.DivideZero,
  -clang-analyzer-core.NonNullParamChecker,
  -clang-analyzer-core.NullDereference,
  -clang-analyzer-core.UndefResult,
  -clang-analyzer-security.FloatLoopCounter,
  -clang-analyzer-security.inl.FloatLoopCounter

# --- Header filtering: only analyze project headers, not system/Arduino ---
HeaderFilterRegex: '^(src/|include/).*\.(cpp|h)$'

# --- Treat warnings as errors (CI fails on any warning) ---
WarningsAsErrors: '*'

# --- Format style ---
FormatStyle: file
FormatAdds: true

# --- Check options for embedded safety ---
CheckOptions:
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.ParameterCase
    value: camelBack
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroCase
    value: UPPER_CASE
  - key: readability-identifier-naming.ConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: bugprone-easily-swappable-parameters.MaxSwappable
    value: 3
